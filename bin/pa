#!/usr/bin/env bash
cd "$(dirname "$0")/.." || exit 1

if [ "$1" = "update" ]; then
  exec claude --permission-mode default /update
elif [ "$1" = "work" ]; then
  exec claude "/loop work"
else
  script="$(dirname "$0")/pa-$1"
  if [ -x "$script" ]; then
    shift
    exec "$script" "$@"
  fi
fi

claude "$@"
