#!/usr/bin/env bash
cd "$(dirname "$0")/.." || exit 1

if [ "$1" = "update" ]; then
  set -- "/update"
else
  script="$(dirname "$0")/pa-$1"
  if [ -x "$script" ]; then
    shift
    exec "$script" "$@"
  fi
fi

# the first running pa is the main session, exec keeps the pid for claude
lock=.tmp/pa-main.pid
ps -o comm= -p "$(cat "$lock" 2>/dev/null)" 2>/dev/null | grep -q 'claude$' || echo $$ > "$lock"

exec claude --continue --name pa "$@"
