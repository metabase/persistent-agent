{
  "enabledPlugins": {
    "slack@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "obsidian@obsidian-skills": true
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    }
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/log-permission-request.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(cd workspace/*)"
    ],
    "ask": [
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)"
    ],
    "allow": [
      "Read(memory/**)",
      "Read(workspace/**)",
      "Grep(workspace/**)",
      "Glob(workspace/**)",
      "Edit(workspace/**)",
      "Edit(memory/**)",
      "Read(tasks/**)",
      "Edit(tasks/**)",
      "Edit(.claude/skills/**)",
      "Bash(scripts/data-cmd *)",
      "Bash(scripts/truncate-perms-log)",
      "Bash(scripts/workspace-cmd * git *)",
      "Bash(scripts/workspace-cmd * cat *)",
      "Bash(scripts/workspace-cmd * ls *)",
      "Bash(scripts/workspace-cmd * find *)",
      "Bash(scripts/workspace-cmd * head *)",
      "Bash(scripts/workspace-cmd * grep *)",
      "Bash(scripts/workspace-cmd * curl *)",
      "Bash(scripts/workspace-cmd * gh pr *)",
      "Bash(scripts/workspace-cmd * gh run *)",
      "Bash(scripts/workspace-cmd * gh api *)",
      "Bash(scripts/workspace-cmd * pwd)",
      "Bash(scripts/workspace-cmd * docker *)",
      "Bash(scripts/workspace-cmd * ./scripts/*)",
      "Bash(scripts/workspace-cmd * sed *)",
      "Bash(scripts/workspace-cmd * yarn *)",
      "Bash(scripts/workspace-cmd * npm *)",
      "Bash(scripts/workspace-cmd * bun *)",
      "Bash(scripts/workspace-cmd * bb *)",
      "Bash(scripts/workspace-cmd * clojure *)",
      "Bash(scripts/workspace-cmd * clj *)",
      "mcp__plugin_Notion_notion__notion-search",
      "mcp__plugin_Notion_notion__notion-fetch",
      "mcp__plugin_Notion_notion__notion-get-users",
      "mcp__plugin_linear_linear__list_issues",
      "mcp__plugin_linear_linear__list_issue_statuses",
      "mcp__plugin_linear_linear__list_projects",
      "mcp__plugin_linear_linear__get_issue",
      "mcp__plugin_linear_linear__get_user",
      "mcp__plugin_linear_linear__get_team",
      "mcp__plugin_linear_linear__list_teams",
      "mcp__plugin_linear_linear__get_project",
      "mcp__plugin_slack_slack__slack_search_users",
      "mcp__plugin_slack_slack__slack_search_channels",
      "mcp__plugin_slack_slack__slack_send_message_draft",
      "mcp__plugin_slack_slack__slack_read_thread",
      "mcp__plugin_slack_slack__slack_read_channel",
      "mcp__plugin_slack_slack__slack_read_user_profile",
      "mcp__plugin_linear_linear__list_comments",
      "mcp__plugin_linear_linear__get_initiative",
      "mcp__plugin_linear_linear__list_cycles",
      "mcp__plugin_linear_linear__search_documentation",
      "mcp__plugin_linear_linear__list_milestones",
      "mcp__plugin_linear_linear__list_users",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(curl *)",
      "Bash(claude mcp list)",
      "Bash(gh auth status)",
      "Bash(gh api *)",
      "Bash(gh pr list *)",
      "Bash(gh search *)",
      "Bash(gh repo clone *)",
      "Bash(gh repo view *)",
      "Bash(gh repo list *)",
      "Bash(defuddle parse *)",
      "Bash(mkdir *)"
    ]
  }
}
