#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 2 ]; then
  echo "Usage: scripts/data-cmd <command> [args...]" >&2
  echo "All path arguments must be under memory/ or tasks/" >&2
  exit 1
fi

cmd="$1"
shift

for arg in "$@"; do
  # Skip flags
  case "$arg" in -*)
    continue
    ;;
  esac

  case "$arg" in
    *..*)
      echo "Error: path must not contain ..: $arg" >&2
      exit 1
      ;;
    memory/*|tasks/*) ;;
    *)
      echo "Error: path must be under memory/ or tasks/: $arg" >&2
      exit 1
      ;;
  esac
done

exec "$cmd" "$@"
