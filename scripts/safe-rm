#!/usr/bin/env bash
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "Usage: scripts/safe-rm <path>" >&2
  exit 1
fi

case "$1" in
  *..*)
    echo "Error: path must not contain .." >&2
    exit 1
    ;;
  memory/*|tasks/*) ;;
  *)
    echo "Error: path must be under memory/ or tasks/" >&2
    exit 1
    ;;
esac

rm "$1"
